---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../data/content';

const t = content.ar;
const github = 'https://github.com/hackills/munadi-apks';
---

<Base
  lang="ar"
  title="الخصوصية — نسخة GitHub — منادي"
  description="كيف تتعامل نسخة GitHub من منادي مع البيانات: لا حسابات، ولا إعلانات، ولا تحليلات، ولا أدوات تتبّع. يُستخدم الموقع التقريبي للقبلة واسم المكان ومنطقة المواقيت فقط."
>
  <Header lang="ar" t={t} home="/ar/" alternatePath="/privacy/" />

  <main id="main">
    <section class="document-hero">
      <div class="container">
        <p class="eyebrow">الخصوصية · GitHub</p>
        <h1>سياسة الخصوصية</h1>
        <p>
          منادي تطبيق بسيط لمواقيت الصلاة يعمل دون اتصال، بدأ في قطر.
          تخص هذه السياسة <strong>نسخة GitHub</strong> من منادي، وهي ملف APK الموقّع
          الذي يُنزّل من إصدارات GitHub. يمكن لهذه النسخة التحقق من GitHub عن
          التحديثات وتثبيتها بنفسها.
        </p>
      </div>
    </section>

    <div class="container">
      <article class="document">
        <p class="effective">سارية من: 22 نوفمبر 2026</p>

        <p class="note">
          <strong>هل ثبّتت التطبيق من Google Play؟</strong> نسخة Play تستخدم الإنترنت
          لخريطة المساجد الاختيارية فقط ولا تحتوي على محدّث داخل التطبيق، ولها سياسة خاصة:
          <a href="/ar/privacy/play/">اقرأ سياسة نسخة Google Play</a>.
        </p>

        <h2>الملخص</h2>
        <ul>
          <li>لا حسابات، ولا إعلانات، ولا تحليلات، ولا أدوات تتبّع.</li>
          <li>تبقى مواقيت الصلاة والإعدادات على جهازك.</li>
          <li>
            يُستخدم الموقع التقريبي لبوصلة القبلة، واسم المكان، ومنطقة مواقيت الصلاة.
          </li>
          <li>لا يُطلب الموقع الدقيق إلا في باحث المساجد في قطر، ويبقى على جهازك.</li>
          <li>لا نُشغّل خادمًا يستقبل بياناتك.</li>
        </ul>

        <h2>البيانات التي يستخدمها التطبيق</h2>

        <h3>الموقع التقريبي</h3>
        <p>
          يُستخدم الموقع التقريبي لحساب اتجاه القبلة والمسافة إليها، وعرض اسم المكان،
          واقتراح أقرب منطقة لمواقيت الصلاة. هذه الميزات لا تطلب الموقع الدقيق أبدًا.
          يُحفظ آخر موقع تقريبي واسم المكان في التخزين الخاص بالتطبيق حتى تفتح شاشة
          القبلة بسرعة.
        </p>
        <p>
          تُطابق أسماء الأماكن على الجهاز من قائمة مضمّنة. وعندما يكون الموقع مسموحًا
          به مسبقًا، قد يتحقق التطبيق منه عند التشغيل لاقتراح منطقة. لا يُرسل موقعك إلى
          أي جهة.
        </p>
        <p>
          عند التشغيل الأول يقرأ منادي أيضًا بلد شبكة الجوال وبطاقة SIM دون أي إذن، لفتح
          البلد المناسب في قائمة المدن فقط. تبقى هذه المعلومة على جهازك. وقد يقترح الموقع
          أقرب مدينة مدرجة في أي منطقة، ولا يغيّرها لك.
        </p>

        <h3>الموقع الدقيق وباحث المساجد (قطر)</h3>
        <p>
          عندما تكون قطر هي البلد المختار، يوفّر منادي باحثًا عن المساجد. يعرض المساجد
          من دليل مضمّن داخل التطبيق ويرتبها حسب بُعدها عنك. الموقع التقريبي غير دقيق
          بمقدار كيلومتر أو أكثر، وهذا لا يكفي لمعرفة أقرب مسجد، ولذلك تطلب هذه الشاشة
          وحدها الموقع الدقيق. يمكنك اختيار «تقريبي» في نافذة النظام، أو الرفض، وتصفح
          الدليل والبحث فيه مع ذلك.
        </p>
        <p>
          يُقرأ موقعك فقط أثناء فتح باحث المساجد، ويُقارن بالدليل على جهازك، ولا يحفظه
          الباحث ولا يُرسل إلى أي جهة. عند الضغط على «الاتجاهات» أو «مشاركة» يسلّم منادي
          إحداثيات المسجد، لا إحداثياتك، إلى تطبيق الخرائط أو التطبيق الذي تختاره؛ وما
          يفعله ذلك التطبيق بها تحكمه سياسته.
        </p>

        <h3>خريطة المساجد (قطر)</h3>
        <p>
          يمكن لباحث المساجد أن يعرض خريطة شوارع أيضًا. الخريطة اختيارية وتستأذنك قبل
          أول استخدام. تُرسم داخل التطبيق من مربعات خرائط تُطلب من
          <a href="https://openfreemap.org" rel="noopener">OpenFreeMap</a>، وقد تُسلَّم
          عبر Cloudflare. وكما في أي موقع تفتحه، تتلقى تلك الخدمة عنوان IP لجهازك
          ومنطقة الخريطة المطلوبة، فتعرف تقريبًا المنطقة التي تتصفحها. لا يرسل منادي
          موقعك ولا أي معرّف ولا أي شيء عنك مع تلك الطلبات، ولا يُرسل إلينا شيء. قد
          تُحفظ المربعات التي شاهدتها في ذاكرة التطبيق المؤقتة على جهازك. وإن لم تفتح
          الخريطة فلن يحدث شيء من ذلك.
        </p>

        <h3>الإعدادات والجدول</h3>
        <p>
          يُحفظ المظهر واللون واللغة ومدينة مواقيت الصلاة واختيار حساب العصر وتعديل
          التاريخ الهجري وتعديلات الإقامة وتفضيلات التنبيهات وأصوات الأذان محليًا على
          جهازك.
        </p>
        <p>
          في قطر تأتي المواقيت من جدول دار التقويم القطري المضمّن داخل التطبيق، وتستخدم
          جدول الدوحة افتراضيًا. يمكنك اختيار أبو سمرة أو دخان أو الشمال من الإعدادات،
          وقد يقترح التطبيق إحداها عند توفر الموقع.
        </p>
        <p>
          وفي كل بلد آخر يدعمه التطبيق، في الخليج وشمال أفريقيا وجنوب آسيا وجنوب
          شرقها وتركيا وروسيا، تُحسب المواقيت على جهازك من إحداثيات المدينة التي
          تختارها في الإعدادات، باستخدام مكتبة حساب مفتوحة المصدر. لا يغادر شيء
          من هذا الحساب جهازك. القائمة الكاملة في صفحة <a
          href="/ar/regions/">المناطق المدعومة</a>.
        </p>
        <p>
          يمكنك تصدير إعداداتك إلى ملف تختاره واستيراده لاحقًا. يُحفظ الملف حيث تضعه،
          ولا يرفعه منادي.
        </p>

        <h3>التشخيص</h3>
        <p>
          ينشئ «حول ← مشاركة التشخيص» تقريرًا نصيًا لحالات تعطل التنبيه أو
          الودجت أو بوصلة القبلة: إصدار التطبيق وأندرويد، وطراز الهاتف ومستشعرات
          البوصلة فيه، والمدينة المختارة (باسمها، دون إحداثيات)، وإعدادات
          التنبيه وعدم الإزعاج والعرض، وحالة الأذونات والصوت، والمنبهات التي
          يتوقعها التطبيق، وحالة التحقق من السفر (فرق توقيت الهاتف وتوقيت
          المدينة عن التوقيت العالمي)، وآخر استخدام لشاشة القبلة (دقة البوصلة
          وعمر تحديد الموقع ودقته، دون الموقع أو الاتجاه)، والأحداث الأخيرة مثل
          إعادة التشغيل وتنبيهات السفر واستعادة الإعدادات، وأسباب إغلاق التطبيق
          مؤخرًا، وآخر سطور سجل منادي نفسه. لا يُنشأ إلا عند الضغط على الزر، ولا
          يذهب إلا حيث ترسله من قائمة المشاركة. لا يرسله منادي إلى أي مكان من
          تلقاء نفسه.
        </p>

        <h3>الوصول إلى الشبكة</h3>
        <p>
          إذا كانت عمليات التحقق من التحديثات مفعّلة، يطلب التطبيق معلومات أحدث إصدار
          من GitHub. تتلقى GitHub معلومات الشبكة المعتادة مثل عنوان IP ومعرّف التطبيق،
          وفق سياسة خصوصية GitHub. لا يرسل منادي تحليلات أو معرّفات أو بيانات استخدام.
        </p>

        <h3>الأذونات</h3>
        <p>بحسب الميزات التي تستخدمها، قد يطلب التطبيق:</p>
        <ul>
          <li>الموقع التقريبي، للقبلة ومنطقة المواقيت</li>
          <li>الموقع الدقيق، لباحث المساجد في قطر فقط</li>
          <li>الإشعارات، للأذان والإقامة وتنبيهات التحديث</li>
          <li>المنبّهات الدقيقة، للحفاظ على دقة تذكيرات الصلاة</li>
          <li>إعفاء تحسين البطارية، حتى لا تتأخر المنبّهات</li>
          <li>الإنترنت، لعمليات التحقق الاختيارية من التحديثات ولخريطة المساجد الاختيارية</li>
          <li>تثبيت التطبيقات غير المعروفة، للتحديث داخل التطبيق</li>
          <li>تشغيل الوسائط في المقدمة والاهتزاز، للأذان</li>
        </ul>
        <p>يمكنك رفض الأذونات الاختيارية والاستمرار في استخدام مواقيت الصلاة.</p>

        <h2>المشاركة والاحتفاظ</h2>
        <p>
          لا نبيع بياناتك ولا نشاركها. لا حسابات في منادي ولا حزمة تحليلات. تبقى
          البيانات المحلية حتى تمسح مساحة التطبيق أو تلغيه.
        </p>

        <h2>الأطفال</h2>
        <p>
          منادي تطبيق صلاة عام لا يجمع عن قصد معلومات شخصية من الأطفال.
        </p>

        <h2>التغييرات</h2>
        <p>
          قد تُحدّث هذه السياسة. سيتغير تاريخ السريان أعلاه عند ذلك.
        </p>

        <h2>التواصل</h2>
        <p>
          راسلنا على
          <a href="mailto:munadi.prayer@gmail.com">munadi.prayer@gmail.com</a>،
          أو افتح مشكلة على
          <a href={`${github}/issues`} rel="noopener">{github}/issues</a>.
        </p>

        <div class="note">
          <h3>هذا الموقع</h3>
          <p>
            هذا الموقع صفحات ثابتة تُستضاف على Vercel. لا يستخدم ملفات تعريف ارتباط
            أو تحليلات أو نصوص تتبّع. تعالج Vercel معلومات الطلب المعتادة — مثل عنوان
            IP ومعرّف المتصفح — لخدمة الموقع وحمايته، وفق سياسة خصوصية Vercel.
          </p>
        </div>
      </article>
    </div>
  </main>

  <Footer lang="ar" t={t} home="/ar/" />
</Base>
