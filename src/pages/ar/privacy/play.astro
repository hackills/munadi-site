---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { content } from '../../../data/content';

const t = content.ar;
---

<Base
  lang="ar"
  title="الخصوصية — نسخة Google Play — منادي"
  description="كيف تتعامل نسخة Google Play من منادي مع البيانات: لا حسابات، ولا إعلانات، ولا تحليلات، ولا أدوات تتبّع. يُستخدم الموقع التقريبي للقبلة واسم المكان ومنطقة المواقيت فقط."
>
  <Header
    lang="ar"
    t={t}
    home="/ar/"
    alternatePath="/privacy/play/"
    showDownload={false}
  />

  <main id="main">
    <section class="document-hero">
      <div class="container">
        <p class="eyebrow">الخصوصية · Google Play</p>
        <h1>سياسة الخصوصية</h1>
        <p>
          منادي تطبيق بسيط لمواقيت الصلاة يعمل دون اتصال، بدأ في قطر.
          تخص هذه السياسة <strong>نسخة Google Play</strong> من منادي، النسخة التي
          تُثبّت وتُحدّث عبر Google Play. لا تطلب إذن الإنترنت.
        </p>
      </div>
    </section>

    <div class="container">
      <article class="document">
        <p class="effective">سارية من: 8 نوفمبر 2026</p>

        <h2>الملخص</h2>
        <ul>
          <li>لا حسابات، ولا إعلانات، ولا تحليلات، ولا أدوات تتبّع.</li>
          <li>تبقى مواقيت الصلاة والإعدادات على جهازك.</li>
          <li>
            يُستخدم الموقع التقريبي لبوصلة القبلة، واسم المكان، ومنطقة مواقيت الصلاة.
          </li>
          <li>لا يطلب التطبيق إذن الإنترنت ولا يرسل إلينا أي بيانات.</li>
        </ul>

        <h2>البيانات التي يستخدمها التطبيق</h2>

        <h3>الموقع التقريبي</h3>
        <p>
          يطلب منادي <strong>الموقع التقريبي فقط</strong>، ولا يطلب الموقع الدقيق.
          يُستخدم لحساب اتجاه القبلة والمسافة إليها، وعرض اسم المكان، واقتراح أقرب
          منطقة لمواقيت الصلاة. يُحفظ آخر موقع تقريبي واسم المكان في التخزين الخاص
          بالتطبيق حتى تفتح شاشة القبلة بسرعة.
        </p>
        <p>
          تُطابق أسماء الأماكن على الجهاز من قائمة مضمّنة. وعندما يكون الموقع مسموحًا
          به مسبقًا، قد يتحقق التطبيق منه عند التشغيل لاقتراح منطقة. لا يُرسل موقعك إلى
          أي جهة.
        </p>
        <p>
          عند التشغيل الأول يقرأ منادي أيضًا بلد شبكة الجوال وبطاقة SIM دون أي إذن، لفتح
          البلد المناسب في قائمة المدن فقط. تبقى هذه المعلومة على جهازك. وقد يقترح الموقع
          أقرب مدينة مدرجة في أي منطقة، ولا يغيّرها لك.
        </p>

        <h3>الإعدادات والجدول</h3>
        <p>
          يُحفظ المظهر واللون واللغة ومدينة مواقيت الصلاة واختيار حساب العصر وتعديل
          التاريخ الهجري وتعديلات الإقامة وتفضيلات التنبيهات وأصوات الأذان محليًا على
          جهازك.
        </p>
        <p>
          في قطر تأتي المواقيت من جدول دار التقويم القطري المضمّن داخل التطبيق، وتستخدم
          جدول الدوحة افتراضيًا. يمكنك اختيار أبو سمرة أو دخان أو الشمال من الإعدادات،
          وقد يقترح التطبيق إحداها عند توفر الموقع.
        </p>
        <p>
          وفي المناطق الأخرى (حاليًا المملكة العربية السعودية والإمارات العربية المتحدة والكويت وسلطنة عمان وباكستان) تُحسب المواقيت على جهازك من إحداثيات
          المدينة التي تختارها في الإعدادات، باستخدام مكتبة حساب مفتوحة المصدر. لا يغادر
          شيء من هذا الحساب جهازك.
        </p>
        <p>
          يمكنك تصدير إعداداتك إلى ملف تختاره واستيراده لاحقًا. يُحفظ الملف حيث تضعه،
          ولا يرفعه منادي.
        </p>

        <h3>الوصول إلى الشبكة</h3>
        <p>
          لا تطلب نسخة Google Play إذن الإنترنت. تتولى Google Play توصيل تحديثات
          التطبيق؛ ولا يتحقق التطبيق نفسه من أي تحديث أو ينزّله أو يثبّته.
        </p>

        <h3>الأذونات</h3>
        <p>بحسب الميزات التي تستخدمها، قد يطلب التطبيق:</p>
        <ul>
          <li>الموقع التقريبي، للقبلة ومنطقة المواقيت</li>
          <li>الإشعارات، لتنبيهات الأذان والإقامة</li>
          <li>المنبّهات الدقيقة، للحفاظ على دقة تذكيرات الصلاة</li>
          <li>تشغيل الوسائط في المقدمة والاهتزاز، للأذان</li>
        </ul>
        <p>يمكنك رفض الأذونات الاختيارية والاستمرار في استخدام مواقيت الصلاة.</p>

        <h2>المشاركة والاحتفاظ</h2>
        <p>
          لا نبيع بياناتك ولا نشاركها. لا حسابات في منادي ولا حزمة تحليلات. تبقى
          البيانات المحلية حتى تمسح مساحة التطبيق أو تلغيه.
        </p>

        <h2>الأطفال</h2>
        <p>
          منادي تطبيق صلاة عام لا يجمع عن قصد معلومات شخصية من الأطفال.
        </p>

        <h2>التغييرات</h2>
        <p>
          قد تُحدّث هذه السياسة. سيتغير تاريخ السريان أعلاه عند ذلك.
        </p>

        <h2>التواصل</h2>
        <p>
          راسلنا على
          <a href="mailto:munadi.prayer@gmail.com">munadi.prayer@gmail.com</a>.
        </p>

        <div class="note">
          <h3>هذا الموقع</h3>
          <p>
            هذا الموقع صفحات ثابتة تُستضاف على Vercel. لا يستخدم ملفات تعريف ارتباط
            أو تحليلات أو نصوص تتبّع. تعالج Vercel معلومات الطلب المعتادة — مثل عنوان
            IP ومعرّف المتصفح — لخدمة الموقع وحمايته، وفق سياسة خصوصية Vercel.
          </p>
        </div>
      </article>
    </div>
  </main>

  <Footer lang="ar" t={t} home="/ar/" showDownload={false} />
</Base>
